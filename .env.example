# Kopiera denna fil till .env.local och fyll i riktiga värden.
# Committa ALDRIG .env eller .env.local.

# --- Kustom Checkout -------------------------------------------------------
# Playground: https://api.playground.kustom.co
# Produktion: https://api.kustom.co
KUSTOM_API_BASE_URL="https://api.playground.kustom.co"
# Format: kco_<live|test>_<api>_<random>
KUSTOM_API_KEY=""
KUSTOM_MERCHANT_ID=""
# "playground" eller "live" — styr vilket värde som visas skrivskyddat i /settings
KUSTOM_ENV="playground"

# --- Publika URL:er ----------------------------------------------------------
NEXT_PUBLIC_STOREFRONT_URL="https://trancoffeelab.com"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3000"

# --- Auth.js / Google OAuth --------------------------------------------------
# Generera med: npx auth secret
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_URL="http://localhost:3000"

# Kommaseparerad lista över Google-adresser som får logga in i backofficet.
# Ändras i Vercel (Project Settings → Environment Variables), aldrig i kod.
ALLOWED_ADMIN_EMAILS="systrarna@trancoffeelab.com"
# Valfritt: kräv att Google-kontot tillhör en viss Workspace-domän (profile.hd).
# Lämna tom om ni loggar in med vanliga Gmail-konton.
ALLOWED_GOOGLE_HD=""

# --- Databas / Supabase -------------------------------------------------------
# Direkt Postgres-anslutning (Drizzle). Använd Supabase-projektets
# "Connection string" (Session pooler eller direct connection).
DATABASE_URL=""
SUPABASE_URL=""
# Endast för server-side bruk (Storage-uppladdning m.m.) — läcker ALDRIG till klienten.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Publika API:et (för Lovable-sajten) --------------------------------------
# Kommaseparerad lista över tillåtna CORS-origins.
PUBLIC_API_ALLOWED_ORIGINS="https://trancoffeelab.com,http://localhost:3000"

# --- E-post --------------------------------------------------------------------
RESEND_API_KEY=""
